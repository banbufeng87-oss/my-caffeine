type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Timestamp = int;
type Result__1 = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Result_2 = 
 variant {
   err: Error;
   ok;
 };
type Result_1 = 
 variant {
   err: PatternError;
   ok;
 };
type Result = 
 variant {
   err: PatternError;
   ok: Pattern;
 };
type PatternSummary = 
 record {
   colorCount: nat;
   createdAt: Timestamp;
   gridHeight: nat;
   gridWidth: nat;
   id: PatternId;
   name: text;
   totalBeads: nat;
 };
type PatternInput = 
 record {
   cells: vec text;
   colorCount: nat;
   colors: vec PatternColor;
   gridHeight: nat;
   gridWidth: nat;
   name: text;
   totalBeads: nat;
 };
type PatternId = nat;
type PatternError = 
 variant {
   invalidInput: text;
   notAuthenticated;
   notFound;
 };
type PatternColor = 
 record {
   code: text;
   count: nat;
   hex: text;
 };
type Pattern = 
 record {
   cells: vec text;
   colorCount: nat;
   colors: vec PatternColor;
   createdAt: Timestamp;
   gridHeight: nat;
   gridWidth: nat;
   id: PatternId;
   name: text;
   totalBeads: nat;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result_2);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  deletePattern: (id: PatternId) -> (Result_1);
  execute: (qJson: text) -> (Result__1) query;
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  getPattern: (id: PatternId) -> (Result) query;
  isCallerAdmin: () -> (bool) query;
  listPatterns: () -> (vec PatternSummary) query;
  savePattern: (input: PatternInput) -> (Result);
  schema: () -> (text) query;
}
